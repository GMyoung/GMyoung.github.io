{
  "version": 1,
  "language": "en",
  "cues": [
    {
      "start": 32.25,
      "end": 35.75,
      "text": "Ain't it just so easy to say"
    },
    {
      "start": 35.75,
      "end": 39.25,
      "text": "You don't feel the same way"
    },
    {
      "start": 39.25,
      "end": 42.75,
      "text": "As that Nice Boy does"
    },
    {
      "start": 42.75,
      "end": 44.25,
      "text": "bae?"
    },
    {
      "start": 44.75,
      "end": 47.25,
      "text": "He misses you, he wants you"
    },
    {
      "start": 47.25,
      "end": 48.25,
      "text": "But"
    },
    {
      "start": 48.75,
      "end": 51.25,
      "text": "You just don't feel the same"
    },
    {
      "start": 51.25,
      "end": 55.25,
      "text": "Why don't you tell him today?"
    },
    {
      "start": 57.75,
      "end": 63.25,
      "text": "She doesn't want him because he cares too much"
    },
    {
      "start": 63.25,
      "end": 69.75,
      "text": "But now he's gone and she's alone again"
    },
    {
      "start": 70.25,
      "end": 76.25,
      "text": "Maybe if you tried a little harder to find"
    },
    {
      "start": 76.75,
      "end": 82.25,
      "text": "The chains within his heart that was there this whole time"
    },
    {
      "start": 82.75,
      "end": 83.25,
      "text": "Bi#ch"
    },
    {
      "start": 128.25,
      "end": 132.75,
      "text": "Baby, what can I do?"
    },
    {
      "start": 132.75,
      "end": 137.25,
      "text": "Baby, come through"
    },
    {
      "start": 137.25,
      "end": 140.75,
      "text": "To me"
    },
    {
      "start": 140.75,
      "end": 145.75,
      "text": "Baby, I think it's you"
    },
    {
      "start": 145.75,
      "end": 150.25,
      "text": "Never was me"
    }
  ]
}

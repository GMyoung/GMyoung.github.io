  "cues": [
    {
      "start": 14.84,
      "end": 17.86,
      "text": "Swear I couldn't sleep a wink last night"
    },
    {
      "start": 17.86,
      "end": 20.94,
      "text": "No point in turning off the lights"
    },
    {
      "start": 20.94,
      "end": 24.86,
      "text": "Not the same without your head on my shoulders"
    },
    {
      "start": 25.04,
      "end": 27.76,
      "text": "Growing pains, but I don't wanna get older"
    },
    {
      "start": 27.76,
      "end": 30.88,
      "text": "Almost like we left it all on read"
    },
    {
      "start": 30.88,
      "end": 34.1,
      "text": "A couple feelings that were laid to rest"
    },
    {
      "start": 34.1,
      "end": 37.62,
      "text": "Didn't know that the party was over"
    },
    {
      "start": 37.62,
      "end": 41.06,
      "text": "And it's true that I need you here closer"
    },
    {
      "start": 42.78,
      "end": 44.14,
      "text": "Burning photos"
    },
    {
      "start": 44.14,
      "end": 47.34,
      "text": "Had to learn to let go"
    },
    {
      "start": 47.34,
      "end": 55.04,
      "text": "I used to be"
    },
    {
      "start": 55.04,
      "end": 57.52,
      "text": "Somebody in another skin"
    },
    {
      "start": 57.52,
      "end": 64.36,
      "text": "I heard that you're happy without me"
    },
    {
      "start": 64.36,
      "end": 68.86,
      "text": "And I hope it's true"
    },
    {
      "start": 72.1,
      "end": 77.28,
      "text": "It kills me a little, that's okay"
    },
    {
      "start": 77.28,
      "end": 80.9,
      "text": "'Cause I'd die for you"
    },
    {
      "start": 82.2,
      "end": 86.78,
      "text": "You know I'd still die for you"
    },
    {
      "start": 98.62,
      "end": 101.92,
      "text": "I hope you're getting everything you needed"
    },
    {
      "start": 102.72,
      "end": 105.02,
      "text": "Found the puzzle piece and feel completed"
    },
    {
      "start": 105.2,
      "end": 108.38,
      "text": "Just wanted you to know every reason"
    },
    {
      "start": 108.7,
      "end": 111.62,
      "text": "Hope you really know that I mean that"
    },
    {
      "start": 111.62,
      "end": 113.54,
      "text": "I couldn't see"
    },
    {
      "start": 114.14,
      "end": 116.92,
      "text": "The forest from the trees"
    },
    {
      "start": 116.92,
      "end": 120.02,
      "text": "The only time we speak"
    },
    {
      "start": 120.66,
      "end": 123.76,
      "text": "Is in my dreams"
    },
    {
      "start": 126.14,
      "end": 128.48,
      "text": "Burning photos"
    },
    {
      "start": 128.48,
      "end": 131.66,
